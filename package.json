{
  "name": "disparador",
  "version": "0.5.0",
  "description": "Campanhas, conversas e gestão de grupos no WhatsApp",
  "main": "./out/main/index.js",
  "author": "Danilo Ribeiro",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "test": "vitest run",
    "build:all": "npm run build && electron-builder --mac --win --publish never",
    "release": "npm run build && electron-builder --mac --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "baileys": "7.0.0-rc14",
    "electron-updater": "6.8.11",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "2.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "1.68.0",
    "patch-package": "8.0.1",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.1.0",
    "zustand": "5.0.16"
  },
  "productName": "Disparador",
  "type": "module"
}
